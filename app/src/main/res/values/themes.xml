<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      The app's visible UI is 100% Jetpack Compose + Material 3. These XML
      themes only cover the pre-Compose window: a base theme with no action bar
      and a splash-screen theme shown until the first frame is drawn.
    -->
    <style name="Theme.MiniPlay" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_violet_dark</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
    </style>

    <style name="Theme.MiniPlay.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_violet_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MiniPlay</item>
    </style>
</resources>
